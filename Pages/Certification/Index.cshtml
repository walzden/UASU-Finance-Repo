@page
@model UASU_VoucherApprovals.Pages.Certification.IndexModel

<h3 class="mb-3">Monthly Cash Book Certification</h3>
<p class="text-muted">Labour Relations (Accounts) Regulations, reg. 8(2)/9(2): balance the cash book at the end of every month and certify that it agrees with actual cash in hand and cash at the bank.</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<details class="mb-4">
    <summary>Opening Balance (one-time starting point, as of @Model.OpeningBalanceInput.As_Of_Date.ToString("yyyy-MM-dd"): Sh. @Model.OpeningBalanceInput.Cash_Balance.ToString("N2") cash / Sh. @Model.OpeningBalanceInput.Bank_Balance.ToString("N2") bank)</summary>
    <p class="form-text mt-2">Book balances below are computed purely from what this app has recorded - if there was money in the account before you started using it, that starting figure needs to be set here, or every certification will show a variance that isn't real.</p>
    <form method="post" asp-page="/Certification/Index" asp-page-handler="SetOpeningBalance" class="row g-3" style="max-width: 480px;">
        <input type="hidden" name="Year" value="@Model.Year" />
        <input type="hidden" name="Month" value="@Model.Month" />
        <div class="col-md-4">
            <label class="form-label">As Of Date</label>
            <input asp-for="OpeningBalanceInput.As_Of_Date" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Cash Balance (Sh.)</label>
            <input asp-for="OpeningBalanceInput.Cash_Balance" type="number" step="0.01" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Bank Balance (Sh.)</label>
            <input asp-for="OpeningBalanceInput.Bank_Balance" type="number" step="0.01" class="form-control" />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-outline-secondary">Save Opening Balance</button>
        </div>
    </form>
</details>

<form method="get" asp-page="/Certification/Index" class="row g-3 align-items-end" style="max-width: 480px;">
    <div class="col-6">
        <label class="form-label">Year</label>
        <input name="year" type="number" value="@Model.Year" class="form-control" />
    </div>
    <div class="col-6">
        <label class="form-label">Month</label>
        <select name="month" class="form-select">
            @for (var m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>
            }
        </select>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-secondary">Load Period</button>
    </div>
</form>

@{
    var monthLabel = $"{IndexModel.MonthName(Model.Month)} {Model.Year}";
    var monthEndLabel = new DateTime(Model.Year, Model.Month, 1).AddMonths(1).AddDays(-1).ToString("d MMM yyyy");
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-3" style="max-width: 820px;">@Model.ErrorMessage</div>
}

<h4 class="mt-4">Book balances for @monthLabel</h4>
<table class="table table-sm align-middle" style="max-width: 640px;">
    <thead class="table-light">
        <tr>
            <th></th>
            <th class="text-end">Opening<div class="small text-muted fw-normal">end of previous month</div></th>
            <th class="text-end">Movement<div class="small text-muted fw-normal">during @IndexModel.MonthName(Model.Month)</div></th>
            <th class="text-end">Closing<div class="small text-muted fw-normal">book, @monthEndLabel</div></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <th>Cash</th>
            <td class="text-end">@Model.OpeningCash.ToString("N2")</td>
            <td class="text-end">@((Model.BookCashBalance - Model.OpeningCash).ToString("+#,##0.00;-#,##0.00;0.00"))</td>
            <td class="text-end fw-semibold">@Model.BookCashBalance.ToString("N2")</td>
        </tr>
        <tr>
            <th>Bank</th>
            <td class="text-end">@Model.OpeningBank.ToString("N2")</td>
            <td class="text-end">@((Model.BookBankBalance - Model.OpeningBank).ToString("+#,##0.00;-#,##0.00;0.00"))</td>
            <td class="text-end fw-semibold">@Model.BookBankBalance.ToString("N2")</td>
        </tr>
    </tbody>
</table>
<div class="form-text mb-3" style="max-width: 640px;">Computed from what's recorded up to and including month-end. Cash is cash in hand, including cash drawn from the bank; M-Pesa, bank transfers and cheques paid straight from the account count as bank.</div>

<div class="card mb-4" style="max-width: 820px;">
    <div class="card-header fw-semibold">What could explain a variance &mdash; as at @monthEndLabel</div>
    <div class="card-body">
        @if (!Model.Hints.Any())
        {
            <p class="mb-0 text-success">Nothing outstanding that the app knows of. If the figures still don't agree, look for something not entered at all (a payment, a charge, money received).</p>
        }
        else
        {
            <p class="small text-muted">Things recorded in the app that are unfinished at month-end. Each can make your count or bank statement differ from the book. Sort them out first, or mention them in the notes.</p>
            <ul class="list-unstyled mb-0">
                @foreach (var h in Model.Hints)
                {
                    <li class="hint mb-3">
                        <div class="d-flex flex-wrap align-items-baseline gap-2">
                            <span class="fw-semibold">@h.Title</span>
                            <span class="badge bg-secondary">@h.Count</span>
                            @if (h.Amount is not null)
                            {
                                <span class="fw-semibold">Sh. @h.Amount.Value.ToString("N2")</span>
                            }
                            <span class="small text-muted">affects @h.Affects.ToLowerInvariant()</span>
                            @if (h.LinkPage is not null)
                            {
                                <a class="small ms-auto" href="@h.LinkPage">@h.LinkText &rarr;</a>
                            }
                        </div>
                        <div class="small">@h.Explanation</div>
                        @if (h.Examples.Any())
                        {
                            <div class="small text-muted">@string.Join(" · ", h.Examples)@(h.Count > h.Examples.Count && h.Examples.Count >= 6 ? " …" : "")</div>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>

@if (Model.Floats.Any())
{
    <h5 class="mt-3">Cash Out in Floats at Month-End</h5>
    <p class="form-text mb-2">
        Part of the book Cash above is with officials holding cash floats, not with the treasury. Receipts they have
        spent but that are not yet retired, approved and settled are still counted as cash in the books &mdash; so the
        physical count comes out lower than book Cash by that amount until they are settled.
    </p>
    <table class="table table-sm table-bordered align-middle" style="max-width: 820px;">
        <thead class="table-light">
            <tr>
                <th>Float</th>
                <th>Custodian</th>
                <th>Purpose</th>
                <th class="text-end">Cash With Custodian</th>
                <th class="text-end">Receipts Not Yet Settled</th>
                <th class="text-end">In Book Cash</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Model.Floats)
            {
                <tr>
                    <td><a asp-page="/Floats/Details" asp-route-id="@f.Float_ID">@f.Float_ID</a></td>
                    <td>@f.CustodianName</td>
                    <td>@f.Purpose</td>
                    <td class="text-end">@f.CashWithCustodian.ToString("N2")</td>
                    <td class="text-end">@((f.Spent - f.Settled).ToString("N2"))</td>
                    <td class="text-end">@f.BookOutstanding.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light fw-bold">
            <tr>
                <td colspan="3" class="text-end">Total</td>
                <td class="text-end">@Model.FloatCashWithCustodians.ToString("N2")</td>
                <td class="text-end">@Model.FloatReceiptsNotSettled.ToString("N2")</td>
                <td class="text-end">@Model.CashInFloats.ToString("N2")</td>
            </tr>
        </tfoot>
    </table>

    <table class="table table-sm" style="max-width: 480px;">
        <tr><th>Book Cash</th><td class="text-end">Sh. @Model.BookCashBalance.ToString("N2")</td></tr>
        <tr><td class="ps-3">less: out in floats</td><td class="text-end">(@Model.CashInFloats.ToString("N2"))</td></tr>
        <tr class="fw-semibold"><td class="ps-3">Cash the treasury should hold</td><td class="text-end">Sh. @((Model.BookCashBalance - Model.CashInFloats).ToString("N2"))</td></tr>
        <tr><td class="ps-3">plus: cash with custodians</td><td class="text-end">@Model.FloatCashWithCustodians.ToString("N2")</td></tr>
        <tr class="fw-bold border-top"><td>Expected physical cash count</td><td class="text-end">Sh. @((Model.BookCashBalance - Model.FloatReceiptsNotSettled).ToString("N2"))</td></tr>
    </table>
    @if (Model.FloatReceiptsNotSettled != 0)
    {
        <div class="alert alert-warning py-2" style="max-width: 820px;">
            Sh. @Model.FloatReceiptsNotSettled.ToString("N2") of float receipts dated on or before month-end are not yet settled.
            If you certify now, mention them in the notes to explain the cash variance, or settle them first.
        </div>
    }
}

@if (Model.ExistingCertification is { } done)
{
    <div class="alert alert-info" style="max-width: 820px;">
        <strong>@monthLabel is already certified</strong> (@done.Certification_ID, @done.Certified_Date.ToString("d MMM yyyy") by @done.CertifiedByName):
        cash Sh. @done.Actual_Cash_On_Hand.ToString("N2"), bank Sh. @done.Actual_Bank_Balance.ToString("N2")@(done.Balances ? ", agreeing with the book." : " - see the notes in the history below.")
        A month can only be certified once.
    </div>
}
else
{
<div class="card mb-4" style="max-width: 820px;">
    <div class="card-header fw-semibold">Certify @monthLabel</div>
    <div class="card-body">
        <form method="post" asp-page="/Certification/Index" id="certForm" class="row g-3" data-submit-once>
            <input type="hidden" asp-for="Input.Period_Year" />
            <input type="hidden" asp-for="Input.Period_Month" />
            <div class="col-md-6">
                <label asp-for="Input.Actual_Cash_On_Hand" class="form-label">1. Cash counted (Sh.)</label>
                <input asp-for="Input.Actual_Cash_On_Hand" type="number" step="0.01" class="form-control text-end actual" value="@(Model.Checked ? Model.Input.Actual_Cash_On_Hand.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" required />
                <span asp-validation-for="Input.Actual_Cash_On_Hand"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Actual_Bank_Balance" class="form-label">Bank statement balance (Sh.)</label>
                <input asp-for="Input.Actual_Bank_Balance" type="number" step="0.01" class="form-control text-end actual" value="@(Model.Checked ? Model.Input.Actual_Bank_Balance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" required />
                <span asp-validation-for="Input.Actual_Bank_Balance"></span>
            </div>
            <div class="col-12">
                <button type="submit" asp-page-handler="Check" class="btn btn-outline-primary" id="checkBtn" formnovalidate>2. Check figures</button>
                <span class="form-text ms-2">Compares your figures with the book. Nothing is saved.</span>
            </div>

            @if (Model.Checked)
            {
                <div class="col-12" id="checkResult">
                    <table class="table table-sm align-middle mb-2">
                        <thead class="table-light">
                            <tr><th></th><th class="text-end">Book</th><th class="text-end">Actual</th><th class="text-end">Variance</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var (label, book, actual, variance) in new[] {
                                ("Cash in hand", Model.BookCashBalance, Model.Input.Actual_Cash_On_Hand, Model.CashVariance),
                                ("Cash at bank", Model.BookBankBalance, Model.Input.Actual_Bank_Balance, Model.BankVariance) })
                            {
                                <tr class="@(variance == 0 ? "table-success" : "table-warning")">
                                    <th>@label</th>
                                    <td class="text-end">@book.ToString("N2")</td>
                                    <td class="text-end">@actual.ToString("N2")</td>
                                    <td class="text-end fw-semibold">@variance.ToString("+#,##0.00;-#,##0.00;0.00")</td>
                                    <td class="small">@(variance == 0 ? "Agrees" : variance > 0 ? "more than the book" : "less than the book")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (Model.Agrees)
                    {
                        <div class="text-success small mb-2">Both figures agree with the book.</div>
                    }
                    else
                    {
                        <div class="small mb-2">
                            The figures don't agree. Check the list under <em>What could explain a variance</em> above. Either fix what's outstanding and
                            check again, or certify with a note explaining the difference.
                        </div>
                    }
                </div>

                <div class="col-12" id="certifyPart">
                    <label asp-for="Input.Notes" class="form-label">3. Notes @(Model.Agrees ? "(optional)" : "(required: explain the variance)")</label>
                    <textarea asp-for="Input.Notes" class="form-control" rows="2" required="@(!Model.Agrees)"></textarea>
                    <span asp-validation-for="Input.Notes"></span>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" id="certifyBtn"
                                onclick="return confirm('Certify @monthLabel? This is final - a month can only be certified once.');">
                            Certify @monthLabel
                        </button>
                    </div>
                </div>
                <div class="col-12 d-none" id="recheckNote">
                    <div class="alert alert-warning py-2 mb-0">You've changed the figures since checking. Check them again before certifying.</div>
                </div>
            }
        </form>
    </div>
</div>
}

<script>
    // Certify is only offered for the figures that were checked: editing
    // either amount hides it until "Check figures" is pressed again.
    (function () {
        var certify = document.getElementById('certifyPart');
        if (!certify) return;
        document.querySelectorAll('#certForm .actual').forEach(function (input) {
            input.addEventListener('input', function () {
                certify.classList.add('d-none');
                document.getElementById('checkResult').classList.add('d-none');
                document.getElementById('recheckNote').classList.remove('d-none');
            });
        });
    })();
</script>

<h4 class="mt-4">Certification History</h4>
@if (!Model.Certifications.Any())
{
    <p class="text-muted">No months certified yet.</p>
}
else
{
    <p><a class="btn btn-outline-secondary btn-sm" href="?handler=ExportCsv">Export CSV</a></p>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Period</th>
                <th>Book Cash</th>
                <th>Actual Cash</th>
                <th>Book Bank</th>
                <th>Actual Bank</th>
                <th>Agrees?</th>
                <th>Certified By</th>
                <th>Date</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Certifications)
            {
                <tr class="@(c.Balances ? "" : "table-warning")">
                    <td>@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(c.Period_Month) @c.Period_Year</td>
                    <td>@c.Book_Cash_Balance.ToString("N2")</td>
                    <td>@c.Actual_Cash_On_Hand.ToString("N2")</td>
                    <td>@c.Book_Bank_Balance.ToString("N2")</td>
                    <td>@c.Actual_Bank_Balance.ToString("N2")</td>
                    <td>@(c.Balances ? "Yes" : "No - see notes")</td>
                    <td>@c.CertifiedByName</td>
                    <td>@c.Certified_Date.ToString("yyyy-MM-dd")</td>
                    <td>
                        @c.Notes
                        @if (Model.CurrentBook.TryGetValue(c.Certification_ID, out var now)
                             && (now.Cash != c.Book_Cash_Balance || now.Bank != c.Book_Bank_Balance))
                        {
                            <div class="badge bg-danger-subtle text-danger-emphasis text-wrap text-start mt-1"
                                 title="Something dated in or before this month was entered or changed after it was certified.">
                                Book now differs: cash @now.Cash.ToString("N2"), bank @now.Bank.ToString("N2")
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
