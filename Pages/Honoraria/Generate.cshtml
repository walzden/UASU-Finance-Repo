@page
@using System.Globalization
@model UASU_VoucherApprovals.Pages.Honoraria.GenerateModel

<h3 class="mb-1">Generate Monthly Honoraria</h3>
<p class="text-muted">Creates one voucher per current official using the amounts in <a asp-page="/Honoraria/Rates">Honoraria Rates</a>. The vouchers still need Chairman and Chapter Secretary approval.</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
}

<form method="get" class="row g-3 mb-4" style="max-width: 900px;">
    <div class="col-md-3">
        <label class="form-label">Month</label>
        <select name="Month" class="form-select">
            @for (var m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(Model.Month == m)">@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Year</label>
        <select name="Year" class="form-select">
            @for (var y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
            {
                <option value="@y" selected="@(Model.Year == y)">@y</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Voucher date</label>
        <input type="date" name="VoucherDate" class="form-control" value="@((Model.VoucherDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Budget code</label>
        <select name="Budget_Link" class="form-select">
            <option value="">-- select --</option>
            @foreach (var b in Model.BudgetCodes)
            {
                <option value="@b.Id" selected="@(Model.Budget_Link == b.Id)">@b.Label</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Description <span class="text-muted">(optional)</span></label>
        <input name="CustomDescription" class="form-control" maxlength="255" value="@Model.CustomDescription" placeholder="@Model.EffectiveDescription" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-primary">Preview</button>
        <span class="form-text ms-2">Vouchers will be described as: <strong>@Model.EffectiveDescription</strong></span>
    </div>
</form>

@if (Model.ReadyCount > 0)
{
    <div class="mb-2" style="max-width: 900px;">
        <span class="text-muted small">Tick the officials to pay this time; only they get a voucher.</span>
        <button type="button" class="btn btn-sm btn-link" id="tickAll">Tick all</button> |
        <button type="button" class="btn btn-sm btn-link" id="tickNone">Untick all</button>
    </div>
}

<table class="table table-sm align-middle" style="max-width: 900px;">
    <thead>
        <tr>
            <th style="width:2rem;"></th>
            <th>Official</th>
            <th>Position</th>
            <th class="text-end">Amount (KES)</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Preview)
        {
            <tr class="@(p.Status == "Ready" ? "" : "text-muted")">
                <td>
                    @if (p.Status == "Ready")
                    {
                        <input type="checkbox" class="form-check-input pick" form="generateForm" name="SelectedOfficials"
                               value="@p.OfficialID" data-amount="@((p.Amount ?? 0).ToString("0.00", CultureInfo.InvariantCulture))" checked
                               aria-label="Generate a voucher for @p.FullName" />
                    }
                </td>
                <td>@p.FullName</td>
                <td>@p.Role</td>
                <td class="text-end">@(p.Amount?.ToString("N2") ?? "-")</td>
                <td>
                    @if (p.Status == "Ready")
                    {
                        <span class="badge bg-success ready-badge">Will be created</span>
                    }
                    else if (p.Status == "AlreadyGenerated")
                    {
                        <span class="badge bg-secondary">Already generated</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">No rate for this position</span>
                    }
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th></th>
            <th colspan="2">To be created: <span id="pickCount">@Model.ReadyCount</span></th>
            <th class="text-end" id="pickTotal">@Model.ReadyTotal.ToString("N2")</th>
            <th></th>
        </tr>
    </tfoot>
</table>

@if (Model.ReadyCount > 0)
{
    <form method="post" id="generateForm" data-submit-once>
        <input type="hidden" name="Month" value="@Model.Month" />
        <input type="hidden" name="Year" value="@Model.Year" />
        <input type="hidden" name="VoucherDate" value="@((Model.VoucherDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="Budget_Link" value="@Model.Budget_Link" />
        <input type="hidden" name="CustomDescription" value="@Model.CustomDescription" />
        <button type="submit" class="btn btn-primary" id="generateBtn">Generate @Model.ReadyCount voucher(s)</button>
    </form>

    <script>
        (function () {
            var picks = Array.prototype.slice.call(document.querySelectorAll('.pick'));
            var btn = document.getElementById('generateBtn');
            var fmt = function (n) { return n.toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };

            function summary() {
                var ticked = picks.filter(function (p) { return p.checked; });
                var total = ticked.reduce(function (s, p) { return s + parseFloat(p.dataset.amount); }, 0);
                document.getElementById('pickCount').textContent = ticked.length;
                document.getElementById('pickTotal').textContent = fmt(total);
                btn.textContent = 'Generate ' + ticked.length + ' voucher' + (ticked.length === 1 ? '' : 's');
                btn.disabled = ticked.length === 0;
                // Unticked rows read as "won't be created" at a glance.
                picks.forEach(function (p) {
                    var row = p.closest('tr');
                    row.classList.toggle('text-muted', !p.checked);
                    var badge = row.querySelector('.ready-badge');
                    badge.textContent = p.checked ? 'Will be created' : 'Skipped this time';
                    badge.className = 'badge ready-badge ' + (p.checked ? 'bg-success' : 'bg-light text-dark border');
                });
                return { count: ticked.length, total: total };
            }

            picks.forEach(function (p) { p.addEventListener('change', summary); });
            document.getElementById('tickAll').addEventListener('click', function () { picks.forEach(function (p) { p.checked = true; }); summary(); });
            document.getElementById('tickNone').addEventListener('click', function () { picks.forEach(function (p) { p.checked = false; }); summary(); });

            document.getElementById('generateForm').addEventListener('submit', function (e) {
                var s = summary();
                if (!confirm('Create ' + s.count + ' voucher(s) totalling KES ' + fmt(s.total) + '?')) e.preventDefault();
            });

            summary();
        })();
    </script>
}
else
{
    <div class="text-muted">Nothing left to generate for this description.</div>
}
