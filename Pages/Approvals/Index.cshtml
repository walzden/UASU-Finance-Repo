@page
@model UASU_VoucherApprovals.Pages.Approvals.IndexModel

<h3 class="mb-3">Vouchers awaiting your approval</h3>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
}

@if (!Model.Groups.Any() && !Model.Ungrouped.Any())
{
    <p class="text-muted">Nothing pending your review.</p>
}
else
{
    var ownTotal = Model.AllPending.Count(v => v.IsOwnVoucher);

    <div class="approve-all-bar d-flex flex-wrap align-items-center gap-3 mb-4">
        <div>
            <div class="fw-semibold">@Model.AllPending.Count voucher@(Model.AllPending.Count == 1 ? "" : "s") awaiting your approval</div>
            <div class="text-muted small">
                Sh. @Model.AllPending.Sum(v => v.Amount).ToString("N2") across @Model.ByBudget.Count budget code@(Model.ByBudget.Count == 1 ? "" : "s")
            </div>
        </div>
        <button type="button" class="btn btn-success ms-auto" data-bs-toggle="modal" data-bs-target="#approveAllModal">
            Review &amp; approve all&hellip;
        </button>
    </div>

    @* "Review & approve all": a summary per budget code, approvable one
       code at a time or all at once. Every voucher shown is a hidden input
       tagged with its budget code and whether it's payable to this
       approver; the clicked button's scope decides which ones are sent
       (see the script below), and BulkApprove then checks each one in the
       database exactly as the weekly cards do. *@
    <div class="modal fade" id="approveAllModal" tabindex="-1" aria-labelledby="approveAllTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <form method="post" asp-page-handler="BulkApprove" id="approveAllForm" class="modal-content" data-submit-once>
                <div class="modal-header">
                    <h5 class="modal-title" id="approveAllTitle">Approve vouchers awaiting you</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @foreach (var v in Model.AllPending)
                    {
                        <input type="hidden" name="voucherIds" value="@v.Voucher_ID"
                               data-budget="@(v.Budget_ID ?? "none")" data-own="@(v.IsOwnVoucher ? "1" : "0")" />
                    }

                    <table class="table table-sm align-middle mb-2">
                        <thead class="table-light">
                            <tr>
                                <th>Budget code</th>
                                <th class="text-end">Vouchers</th>
                                <th class="text-end">Total (Sh.)</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.ByBudget)
                            {
                                <tr>
                                    <td>
                                        @b.Label
                                        @if (b.OwnCount > 0)
                                        {
                                            <div class="small text-warning-emphasis">includes @b.OwnCount payable to you</div>
                                        }
                                    </td>
                                    <td class="text-end">@b.Vouchers.Count</td>
                                    <td class="text-end">@b.Total.ToString("N2")</td>
                                    <td class="text-end">
                                        <button type="submit" class="btn btn-outline-success btn-sm text-nowrap scope-btn" data-scope="@b.Key">
                                            Approve <span class="scope-count"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold">
                            <tr>
                                <td>All budget codes</td>
                                <td class="text-end">@Model.AllPending.Count</td>
                                <td class="text-end">@Model.AllPending.Sum(v => v.Amount).ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>

                    @if (ownTotal > 0)
                    {
                        <div class="alert alert-warning py-2 mb-3">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="includeOwn" />
                                <label class="form-check-label" for="includeOwn">
                                    Also approve the @ownTotal voucher@(ownTotal == 1 ? "" : "s") payable to me
                                </label>
                            </div>
                            <div class="small">Left out unless ticked. The other approver still has to sign them off separately.</div>
                        </div>
                    }

                    <label for="approveAllComments" class="form-label small text-muted mb-1">Comment for every voucher approved (optional)</label>
                    <textarea name="comments" id="approveAllComments" class="form-control" rows="2"></textarea>
                </div>
                <div class="modal-footer">
                    <span class="me-auto small text-muted">Only approves &mdash; to reject one, use its own Reject button on the page.</span>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success scope-btn" data-scope="all">
                        Approve all <span class="scope-count"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <h5 class="mb-2 text-muted" style="font-size:1rem;">@(Model.Groups.Any() ? "Or review them by week and budget code" : "Or review them one by one")</h5>

    @foreach (var group in Model.Groups)
    {
        <div class="group-card">
            <div class="group-header">
                <span class="title">@group.Budget_ID &middot; @group.Budget_Category</span>
                <span class="meta">
                    Week of @group.WeekStart.ToString("yyyy-MM-dd") &middot; @group.Vouchers.Count vouchers &middot;
                    Sh. @group.Vouchers.Sum(v => v.Amount).ToString("N2") total
                </span>
                <form method="post" asp-page-handler="BulkApprove" class="ms-auto d-flex align-items-center gap-2">
                    @foreach (var v in group.Vouchers)
                    {
                        <input type="hidden" name="voucherIds" value="@v.Voucher_ID" />
                    }
                    <textarea name="comments" class="form-control form-control-sm" placeholder="Comments for all @group.Vouchers.Count (optional)" style="width:220px;" rows="1"></textarea>
                    <button type="submit" class="btn btn-success btn-sm">Approve all @group.Vouchers.Count</button>
                </form>
            </div>
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Voucher</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Payee</th>
                        <th>Amount</th>
                        <th>Description</th>
                        <th>Other approver</th>
                        <th style="width:280px;">Decision</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in group.Vouchers)
                    {
                        <partial name="_ApprovalRow" model="v" />
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Ungrouped.Any())
    {
        if (Model.Groups.Any())
        {
            <h5 class="mb-2 text-muted" style="font-size:1rem;">Not part of a group</h5>
        }

        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Voucher</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Payee</th>
                    <th>Amount</th>
                    <th>Description</th>
                    <th>Other approver</th>
                    <th style="width:280px;">Decision</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Ungrouped)
                {
                    <partial name="_ApprovalRow" model="v" />
                }
            </tbody>
        </table>
    }
}

<script>
    (function () {
        var form = document.getElementById('approveAllForm');
        if (!form) return;
        var ids = Array.prototype.slice.call(form.querySelectorAll('input[name="voucherIds"]'));
        var own = document.getElementById('includeOwn');

        function inScope(input, scope) {
            if (input.dataset.own === '1' && !(own && own.checked)) return false;
            return scope === 'all' || input.dataset.budget === scope;
        }

        // Each button shows how many vouchers it would approve right now
        // (it changes when "payable to me" is ticked); a code whose only
        // vouchers are the approver's own gets a disabled button.
        function refresh() {
            form.querySelectorAll('.scope-btn').forEach(function (btn) {
                var n = ids.filter(function (i) { return inScope(i, btn.dataset.scope); }).length;
                btn.querySelector('.scope-count').textContent = n + ' voucher' + (n === 1 ? '' : 's');
                btn.disabled = n === 0;
            });
        }
        if (own) own.addEventListener('change', refresh);
        refresh();

        // Only the clicked scope's vouchers are sent: the others are
        // disabled so the browser leaves them out of the post.
        form.addEventListener('submit', function (e) {
            var scope = e.submitter ? e.submitter.dataset.scope : null;
            if (!scope) { e.preventDefault(); return; }
            var chosen = ids.filter(function (i) { return inScope(i, scope); });
            var n = chosen.length;
            if (!confirm('Approve ' + n + ' voucher' + (n === 1 ? '' : 's') + '?')) { e.preventDefault(); return; }
            ids.forEach(function (i) { i.disabled = chosen.indexOf(i) < 0; });
        });

        // Opened, but then closed without approving: put everything back.
        document.getElementById('approveAllModal').addEventListener('hidden.bs.modal', function () {
            ids.forEach(function (i) { i.disabled = false; });
        });
    })();
</script>

<style>
    .approve-all-bar { border: 1px solid rgba(25,135,84,0.35); background: rgba(25,135,84,0.06); border-radius: .5rem; padding: .75rem 1rem; }
    .group-card { border: 1px solid rgba(13,110,253,0.25); border-radius: .5rem; overflow: hidden; margin-bottom: 1.5rem; }
    .group-header { background: rgba(13,110,253,0.08); padding: .75rem 1rem; display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
    .group-header .title { font-weight: 600; }
    .group-header .meta { color: #6c757d; font-size: .85rem; }
</style>
