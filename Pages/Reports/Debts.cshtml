@page
@model UASU_VoucherApprovals.Pages.Reports.DebtsModel
@using UASU_VoucherApprovals.Pages.Reports

@{
    var printPeriodText = Model.PeriodType == DebtPeriodType.All || Model.Period is null
        ? "All periods"
        : DebtsModel.PeriodLabel(Model.Period, Model.PeriodType);
}

<style>
    /* Bootstrap's accordion-button assumes a single line of text; the
       count/total badges need to sit at the far right of the same row. */
    .accordion-button { display: flex; align-items: center; gap: .25rem; }

    /* Print / Save as PDF: only the unsettled debts table, under a
       letterhead. The Settled group, filters, summary cards and buttons
       are hidden, and the Unpaid panel is forced open even if it was
       collapsed on screen. Badges keep their colours - browsers drop
       backgrounds when printing unless told otherwise, which would leave
       white badge text invisible. */
    @@media print {
        .accordion-header { display: none !important; }
        #unpaidGroup.collapse { display: block !important; height: auto !important; }
        .accordion, .accordion-item { border: 0 !important; }
        table { font-size: 12px; }
        tr { break-inside: avoid; }
        thead { display: table-header-group; }
        .badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
</style>

<h3 class="mb-3 d-print-none">Debt Status</h3>

<div class="d-none d-print-block mb-3">
    <div class="d-flex align-items-center gap-3">
        <img src="~/images/uasu-Logo.jpg" alt="UASU logo" style="height:55px;"
             onerror="this.onerror=null; this.src='/images/uasu-logo-placeholder.svg';" />
        <div class="text-center flex-grow-1">
            <h4 class="fw-bold mb-0">UNIVERSITIES' ACADEMIC STAFF UNION</h4>
            <h5 class="mb-0">STATEMENT OF UNSETTLED DEBTS</h5>
            <div class="small text-muted">@printPeriodText &middot; As at @DateTime.Today.ToString("d MMMM yyyy")</div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-3 d-print-none">
    @foreach (var pt in Enum.GetValues<DebtPeriodType>())
    {
        <li class="nav-item">
            <a class="nav-link @(Model.PeriodType == pt ? "active" : "")" href="?periodType=@pt">@pt</a>
        </li>
    }
</ul>

@if (Model.PeriodType != DebtPeriodType.All)
{
    <form method="get" class="row g-2 align-items-end mb-3 d-print-none">
        <input type="hidden" name="periodType" value="@Model.PeriodType" />
        <div class="col-auto">
            <label class="form-label mb-0">@Model.PeriodType</label>
            <select name="period" class="form-select" onchange="this.form.submit()">
                @foreach (var p in Model.AvailablePeriods)
                {
                    <option value="@p" selected="@(Model.Period == p)">@DebtsModel.PeriodLabel(p, Model.PeriodType)</option>
                }
            </select>
        </div>
    </form>
}

@if (!Model.Rows.Any())
{
    <p class="text-muted">No debts recorded for this period.</p>
}
else
{
    <div class="row g-3 mb-4 d-print-none">
        <div class="col-sm-6 col-lg-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Owed</div>
                    <div class="fs-4 fw-bold">@Model.Rows.Sum(d => d.Total_Owed).ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card text-center h-100 border-success">
                <div class="card-body">
                    <div class="text-muted small">Paid</div>
                    <div class="fs-4 fw-bold text-success">@Model.Rows.Sum(d => d.TotalAllocated).ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card text-center h-100 border-danger">
                <div class="card-body">
                    <div class="text-muted small">Unpaid Balance</div>
                    <div class="fs-4 fw-bold text-danger">@Model.Rows.Sum(d => d.Balance).ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="text-muted small">Debts (Settled / Total)</div>
                    <div class="fs-4 fw-bold">@Model.SettledRows.Count() / @Model.Rows.Count()</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3 d-print-none">
        <a class="btn btn-outline-secondary" href="?periodType=@Model.PeriodType&period=@Model.Period&handler=ExportCsv">Export CSV</a>
        <button type="button" class="btn btn-primary ms-1" onclick="window.print()">Print / Save as PDF</button>
        <span class="form-text ms-2">Prints the unsettled debts for the period selected above.</span>
    </div>

    <div class="accordion mb-3" id="debtGroups">
        <div class="accordion-item d-print-none">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#settledGroup">
                    <span class="badge bg-success me-2">&nbsp;</span>
                    Settled
                    <span class="badge bg-secondary ms-2">@Model.SettledRows.Count()</span>
                    <span class="ms-auto text-success fw-bold">@Model.SettledRows.Sum(d => d.TotalAllocated).ToString("N2")</span>
                </button>
            </h2>
            <div id="settledGroup" class="accordion-collapse collapse" data-bs-parent="#debtGroups">
                <div class="accordion-body p-0">
                    @if (!Model.SettledRows.Any())
                    {
                        <p class="text-muted p-3 mb-0">No settled debts in this period.</p>
                    }
                    else
                    {
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Debt</th>
                                    <th>Creditor</th>
                                    <th>Date Incurred</th>
                                    <th>Description</th>
                                    <th class="text-end">Owed (Sh.)</th>
                                    <th class="text-end">Paid (Sh.)</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.SettledRows)
                                {
                                    <tr>
                                        <td>@d.Debt_ID</td>
                                        <td>@d.CreditorName</td>
                                        <td>@d.Date_Incurred.ToString("yyyy-MM-dd")</td>
                                        <td>@d.Description</td>
                                        <td class="text-end">@d.Total_Owed.ToString("N2")</td>
                                        <td class="text-end">@d.TotalAllocated.ToString("N2")</td>
                                        <td><span class="badge bg-success">Settled</span></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="4">Total</td>
                                    <td class="text-end">@Model.SettledRows.Sum(d => d.Total_Owed).ToString("N2")</td>
                                    <td class="text-end">@Model.SettledRows.Sum(d => d.TotalAllocated).ToString("N2")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#unpaidGroup">
                    <span class="badge bg-danger me-2">&nbsp;</span>
                    Unpaid
                    <span class="badge bg-secondary ms-2">@Model.UnpaidRows.Count()</span>
                    <span class="ms-auto text-danger fw-bold">@Model.UnpaidRows.Sum(d => d.Balance).ToString("N2")</span>
                </button>
            </h2>
            <div id="unpaidGroup" class="accordion-collapse collapse show" data-bs-parent="#debtGroups">
                <div class="accordion-body p-0">
                    @if (!Model.UnpaidRows.Any())
                    {
                        <p class="text-muted p-3 mb-0">No unpaid debts in this period.</p>
                    }
                    else
                    {
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Debt</th>
                                    <th>Creditor</th>
                                    <th>Date Incurred</th>
                                    <th>Description</th>
                                    <th class="text-end">Owed (Sh.)</th>
                                    <th class="text-end">Paid (Sh.)</th>
                                    <th class="text-end">Balance (Sh.)</th>
                                    <th>Status</th>
                                    <th>Aging</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.UnpaidRows)
                                {
                                    <tr>
                                        <td>@d.Debt_ID</td>
                                        <td>@d.CreditorName</td>
                                        <td>@d.Date_Incurred.ToString("yyyy-MM-dd")</td>
                                        <td>@d.Description</td>
                                        <td class="text-end">@d.Total_Owed.ToString("N2")</td>
                                        <td class="text-end">@d.TotalAllocated.ToString("N2")</td>
                                        <td class="text-end">@d.Balance.ToString("N2")</td>
                                        <td>
                                            <span class="badge @(d.SettlementStatus == "Partially Paid" ? "bg-warning text-dark" : "bg-secondary")">@d.SettlementStatus</span>
                                        </td>
                                        <td>
                                            @if (d.AgingBucket == "61-90 days")
                                            {
                                                <span class="badge text-dark" style="background-color:#fd7e14;">@d.AgingBucket</span>
                                            }
                                            else
                                            {
                                                <span class="badge @(d.AgingBucket switch {
                                                    "0-30 days" => "bg-success",
                                                    "31-60 days" => "bg-warning text-dark",
                                                    _ => "bg-danger" })">@d.AgingBucket</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="4">Total</td>
                                    <td class="text-end">@Model.UnpaidRows.Sum(d => d.Total_Owed).ToString("N2")</td>
                                    <td class="text-end">@Model.UnpaidRows.Sum(d => d.TotalAllocated).ToString("N2")</td>
                                    <td class="text-end">@Model.UnpaidRows.Sum(d => d.Balance).ToString("N2")</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}
