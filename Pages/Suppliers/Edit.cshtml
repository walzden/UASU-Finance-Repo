@page "{supplierId}"
@model UASU_VoucherApprovals.Pages.Suppliers.EditModel

<h3 class="mb-3">Edit Supplier - @Model.SupplierId</h3>

<form method="post" asp-page="/Suppliers/Edit" class="row g-3" style="max-width: 640px;">
    <div class="col-12">
        <label class="form-label">Business Name</label>
        <input asp-for="Input.Business_Name" class="form-control" />
        <span asp-validation-for="Input.Business_Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Service Category</label>
        <input asp-for="Input.Service_Category" class="form-control" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Tax PIN</label>
        <input asp-for="Input.Tax_PIN" class="form-control" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Phone</label>
        <input asp-for="Input.Contact_Phone" class="form-control" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label class="form-label">Address</label>
        <input asp-for="Input.Address" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="/Suppliers/Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
