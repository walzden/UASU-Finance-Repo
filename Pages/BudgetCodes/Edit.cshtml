@page "{budgetId}"
@model UASU_VoucherApprovals.Pages.BudgetCodes.EditModel

<h3 class="mb-3">Edit Budget Code - @Model.BudgetId</h3>

<form method="post" asp-page="/BudgetCodes/Edit" class="row g-3" style="max-width: 640px;">
    <div class="col-12">
        <label class="form-label">Category Name</label>
        <input asp-for="Input.Category_Name" class="form-control" />
        <span asp-validation-for="Input.Category_Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Category Type</label>
        <select asp-for="Input.Category_Type" class="form-select">
            <option value="Expense">Expense</option>
            <option value="Income">Income</option>
        </select>
        <span asp-validation-for="Input.Category_Type" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="/BudgetCodes/Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
