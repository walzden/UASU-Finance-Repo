@page
@model UASU_VoucherApprovals.Pages.Account.ForgotPasswordModel
@{
    // Standalone, same reasoning as Login.cshtml - reached before
    // signing in, so it isn't nested inside the app's own nav chrome.
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password - MMU UASU Finance App</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/uasu-theme.css" />
    <style>
        html, body { height: 100%; }
        body {
            margin: 0;
            background: #f1f2f7;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 2rem 1rem;
        }
        .auth-card {
            width: 100%;
            max-width: 400px;
            background: #fff;
            border-radius: 1rem;
            padding: 2.25rem 2rem;
            box-shadow: 0 1rem 3rem rgba(0,0,0,.12);
        }
        .auth-card .logo-badge {
            width: 44px; height: 44px; border-radius: .6rem;
            border: 1px solid #e9ecef; display: flex; align-items: center; justify-content: center;
            padding: 4px;
        }
        .auth-card .logo-badge img { max-width: 100%; max-height: 100%; object-fit: contain; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="d-flex gap-2 mb-3">
            <div class="logo-badge">
                <img src="~/images/mmu-logo.jpg" alt="MMU logo"
                     onerror="this.onerror=null; this.src='/images/mmu-logo-placeholder.svg';" />
            </div>
            <div class="logo-badge">
                <img src="~/images/uasu-Logo.jpg" alt="UASU logo"
                     onerror="this.onerror=null; this.src='/images/uasu-logo-placeholder.svg';" />
            </div>
        </div>
        <h2 class="fw-bold mb-1">Forgot Password</h2>
        <p class="text-muted mb-4">Enter your username and we'll email you a code to reset your password.</p>

        <form method="post" asp-page="/Account/ForgotPassword">
            <div class="mb-4">
                <label class="form-label fw-semibold">Username</label>
                <input asp-for="Input.Username" class="form-control form-control-lg" placeholder="Enter your username" autofocus />
                <span asp-validation-for="Input.Username" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Send Reset Code</button>
            <div class="text-center">
                <a asp-page="/Account/Login">Back to Sign In</a>
            </div>
        </form>
    </div>
</body>
</html>
