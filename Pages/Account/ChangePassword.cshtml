@page
@model UASU_VoucherApprovals.Pages.Account.ChangePasswordModel

<div class="row justify-content-center">
    <div class="col-md-5">
        <h3 class="mb-3">Change your password</h3>

        @if (Model.IsForced)
        {
            <div class="alert alert-info">This is your first sign-in — set a new password before continuing.</div>
        }

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
        }

        <form method="post" asp-page="/Account/ChangePassword">
            <div class="mb-3">
                <label class="form-label">Current password</label>
                <input asp-for="Input.CurrentPassword" type="password" class="form-control" autofocus />
                <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">New password</label>
                <input asp-for="Input.NewPassword" type="password" class="form-control" />
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm new password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Update password</button>
        </form>
    </div>
</div>
