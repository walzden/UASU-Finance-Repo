@page
@model UASU_VoucherApprovals.Pages.Account.ResetPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset Password - MMU UASU Finance App</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/uasu-theme.css" />
    <style>
        html, body { height: 100%; }
        body {
            margin: 0;
            background: #f1f2f7;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 2rem 1rem;
        }
        .auth-card {
            width: 100%;
            max-width: 420px;
            background: #fff;
            border-radius: 1rem;
            padding: 2.25rem 2rem;
            box-shadow: 0 1rem 3rem rgba(0,0,0,.12);
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <h2 class="fw-bold mb-1">Reset Password</h2>
        <p class="text-muted mb-3">We've sent a 6-digit code to <strong>@Model.MaskedEmail</strong>. Enter it below along with your new password.</p>

        @if (!string.IsNullOrEmpty(Model.DevPreviewCode))
        {
            <div class="alert alert-warning">
                <strong>Development preview</strong> - no SMTP server is configured yet, so no email was actually sent. The code is: <code>@Model.DevPreviewCode</code>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
        }

        <form method="post">
            <input type="hidden" name="Username" value="@Model.Username" />
            <div class="mb-3">
                <label class="form-label fw-semibold">Verification Code</label>
                <input asp-for="Input.Code" class="form-control form-control-lg" maxlength="6" autofocus autocomplete="one-time-code" />
                <span asp-validation-for="Input.Code" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">New Password</label>
                <input asp-for="Input.NewPassword" type="password" class="form-control form-control-lg" placeholder="Enter your new password" />
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold">Confirm New Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="Confirm your new password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 mb-2">Reset Password</button>
        </form>
        <form method="post" asp-page-handler="Resend">
            <input type="hidden" name="Username" value="@Model.Username" />
            <button type="submit" class="btn btn-link p-0">Resend code</button>
        </form>
    </div>
</body>
</html>
