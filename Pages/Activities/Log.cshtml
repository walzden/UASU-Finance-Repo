@page
@model UASU_VoucherApprovals.Pages.Activities.LogModel
@using UASU_VoucherApprovals.Models

<h3 class="mb-1">Log an activity</h3>
<p class="text-muted">Log everything you do for the union, as soon as you do it, while the details are fresh. Every official can log, and nothing is approved at this stage: the treasury later decides which activities are paid under the financial policy, and tells you why when one is not. You do not enter an amount.</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">
        @Model.StatusMessage
        <a asp-page="/Activities/History">View it in Activity History</a>.
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.RecordedForMeCount > 0)
{
    <div class="alert alert-warning alert-dismissible" id="recordedForMeNotice" style="display:none;">
        Colleagues have recorded <strong>@Model.RecordedForMeCount</strong> activit@(Model.RecordedForMeCount == 1 ? "y" : "ies") for you. Please check they are right in
        <a asp-page="/Activities/History">Activity History</a> and log anything that is missing.
        <button type="button" class="btn-close" aria-label="Dismiss" onclick="dismissRecordedNotice()"></button>
    </div>
    <script>
        // Remembered per browser, per official and per count: a newly recorded
        // activity brings the notice back, an acknowledged one does not.
        (function () {
            var key = 'recordedForMe-@Model.CurrentOfficialId';
            var count = '@Model.RecordedForMeCount';
            var seen = null;
            try { seen = localStorage.getItem(key); } catch (e) { }
            if (seen !== count) document.getElementById('recordedForMeNotice').style.display = '';
            window.dismissRecordedNotice = function () {
                try { localStorage.setItem(key, count); } catch (e) { }
                document.getElementById('recordedForMeNotice').style.display = 'none';
            };
        })();
    </script>
}

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Date</label>
                            <input asp-for="Input.Activity_Date" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Input.Activity_Date" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Days spent</label>
                            <input asp-for="Input.Days_Spent" type="number" step="0.5" min="0.5" max="31" class="form-control" />
                            <span asp-validation-for="Input.Days_Spent" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Type of activity</label>
                            <select asp-for="Input.Category" class="form-select">
                                @foreach (var c in ActivityLists.Categories)
                                {
                                    <option>@c</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Short title</label>
                            <input asp-for="Input.Title" class="form-control" placeholder="e.g. Finance committee meeting" maxlength="200" />
                            <span asp-validation-for="Input.Title" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label">What was done, and what was the outcome?</label>
                            <textarea asp-for="Input.Details" class="form-control" rows="6" maxlength="2000"></textarea>
                            <span asp-validation-for="Input.Details" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Where</label>
                            <input asp-for="Input.Place" class="form-control" maxlength="200" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Who else was involved</label>
                            <input asp-for="Input.Others_Involved" class="form-control" placeholder="Outside people / bodies" maxlength="300" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Who authorised it?</label>
                            <select asp-for="Input.Authorised_By" class="form-select">
                                @foreach (var a in ActivityLists.AuthorisedBy)
                                {
                                    <option>@a</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Which officials took part?</label>
                            <div class="border rounded p-2" style="max-height:340px; overflow-y:auto;">
                                @foreach (var o in Model.Officials)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Input.ParticipantIds" value="@o.OfficialID" id="p_@o.OfficialID"
                                               checked="@(Model.Input.ParticipantIds.Contains(o.OfficialID))" />
                                        <label class="form-check-label" for="p_@o.OfficialID">
                                            @o.FullName <span class="text-muted small">@o.Role</span>
                                            @if (o.NotSignedIn && o.OfficialID != Model.CurrentOfficialId)
                                            {
                                                <span class="badge bg-light text-dark border">not signed in yet</span>
                                            }
                                        </label>
                                    </div>
                                }
                            </div>
                            <div class="form-text">One entry covers everyone ticked, and each person gets their own line for the treasury. You do not have to be one of them: officials who have not signed in yet can have their activities recorded by a colleague, and the entry shows who recorded it.</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Expenses you paid (KES, optional)</label>
                            <input asp-for="Input.Expenses_Amount" type="number" min="0" step="0.01" class="form-control" />
                            <span asp-validation-for="Input.Expenses_Amount" class="text-danger"></span>
                        </div>
                        <div class="col-6">
                            <label class="form-label">What were they for?</label>
                            <input asp-for="Input.Expenses_Note" class="form-control" maxlength="300" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Evidence (photo, receipt, invitation, minutes, screenshot)</label>
                            <input type="file" name="Input.Evidence" class="form-control" multiple accept="image/jpeg,image/png,application/pdf" />
                            <div class="form-text">Up to 5 files, JPEG, PNG or PDF, 5MB each.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex align-items-center gap-3">
                <button type="submit" class="btn btn-primary">Save activity</button>
                <span class="text-muted small">Everything you have logged is in <a asp-page="/Activities/History">Activity History</a>.</span>
            </div>
        </form>
    </div>
</div>
