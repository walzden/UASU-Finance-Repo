@page
@model UASU_VoucherApprovals.Pages.Activities.DecideModel
@using UASU_VoucherApprovals.Models
@using UASU_VoucherApprovals.Utilities

<h3 class="mb-1">Activity Decisions</h3>
<p class="text-muted">
    Every logged activity lands here as one line per official. Apply the financial policy to each line:
    <strong>Pay</strong> (pick the budget item and type the amount) or <strong>Not payable</strong> (give the policy reason, which the official can see).
    Pay lines become vouchers, one per official per budget item, and go to the Chairman and Chapter Secretary for approval.
    You never decide your own lines: the Treasurer's are decided by the Deputy Treasurer, and the Deputy's by the Treasurer.
</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var e in Model.Errors)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label mb-0">Month</label>
        <select name="Month" class="form-select" onchange="this.form.submit()">
            @foreach (var m in Model.Months)
            {
                <option value="@m" selected="@(m == Model.Month)">@m</option>
            }
        </select>
    </div>
    <div class="col-auto text-muted small pb-2">@Model.OpenLines.Count undecided line(s) this month</div>
</form>

@if (Model.OpenLines.Count == 0)
{
    <div class="alert alert-light border">Every line for @Model.Month has been decided.</div>
}
else
{
    var reasons = ActivityLists.PolicyReasons;
    var index = 0;

    <form method="post" id="decideForm">
        <input type="hidden" name="Month" value="@Model.Month" />

        <div class="row g-2 align-items-end mb-3">
            <div class="col-auto">
                <label class="form-label mb-0">Voucher date</label>
                <input type="date" name="VoucherDate" class="form-control" value="@((Model.VoucherDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">Shortcut: same budget item on every Pay line</label>
                <select class="form-select" onchange="applyBudget(this)">
                    <option value="">-- choose to apply --</option>
                    @foreach (var b in Model.BudgetOptions)
                    {
                        <option value="@b.Id">@b.Label</option>
                    }
                </select>
            </div>
        </div>

        @foreach (var group in Model.OpenLines.GroupBy(l => l.OfficialID))
        {
            var first = group.First();
            var own = first.OfficialID == Model.CurrentOfficialId;
            var chips = Model.CountChips(first.OfficialID);

            <div class="card mb-3">
                <div class="card-header d-flex flex-wrap align-items-center gap-2">
                    <strong>@first.FullName@(own ? " (you)" : "")</strong>
                    <span class="text-muted small">@group.Count() open line@(group.Count() == 1 ? "" : "s")</span>
                    @if (first.NotSignedIn)
                    {
                        <span class="badge bg-light text-dark border">Has not signed in yet: activities recorded by colleagues</span>
                    }
                    @if (first.Role is "Chairman" or "Chapter Secretary")
                    {
                        <span class="badge bg-warning text-dark">Payee is the @first.Role (an approver)</span>
                    }
                    @if (first.Role is "Treasurer" or "Deputy Treasurer")
                    {
                        <span class="badge bg-warning text-dark">Payee is the @first.Role &ndash; decided by the other treasury officer</span>
                    }
                    @if (!string.IsNullOrEmpty(chips))
                    {
                        <span class="badge bg-info text-dark">@chips</span>
                    }
                </div>

                @if (own)
                {
                    <div class="card-body text-muted small">
                        These are your own lines, so you cannot decide them. The other treasury officer will decide them:
                        @string.Join("; ", group.Select(l => l.Title)).
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0" style="min-width: 880px;">
                        <tbody>
                            @foreach (var l in group)
                            {
                                var p = Model.PostedFor(l.Activity_ID, l.OfficialID);
                                <tr data-line="1">
                                    <td style="width:110px;">@l.Activity_Date.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @l.Title
                                        <div class="text-muted small">
                                            @l.Category &middot; @l.Days_Spent.ToString("0.#") day(s) &middot; @l.ParticipantCount took part
                                            @if (l.Expenses_Amount > 0) { <text> &middot; expenses reported @l.Expenses_Amount.ToString("N2") (@l.Expenses_Note)</text> }
                                            &middot; logged by @l.LoggedByName
                                        </div>
                                    </td>
                                    <td style="width:150px;">
                                        <input type="hidden" name="Lines[@index].Activity_ID" value="@l.Activity_ID" />
                                        <input type="hidden" name="Lines[@index].OfficialID" value="@l.OfficialID" />
                                        <select name="Lines[@index].Decision" class="form-select form-select-sm decision" onchange="decChanged(this)">
                                            <option value="">Decide...</option>
                                            <option value="Pay" selected="@(p.Decision == "Pay")">Pay</option>
                                            <option value="NotPayable" selected="@(p.Decision == "NotPayable")">Not payable</option>
                                        </select>
                                    </td>
                                    <td style="width:360px;">
                                        <span class="text-muted small undecided">Choose a decision</span>
                                        <div class="pay" style="display:none; grid-template-columns: 1fr 120px; gap:6px;">
                                            <select name="Lines[@index].Budget_Link" class="form-select form-select-sm budget">
                                                <option value="">Budget item...</option>
                                                @foreach (var b in Model.BudgetOptions)
                                                {
                                                    <option value="@b.Id" selected="@(p.Budget_Link == b.Id)">@b.Label</option>
                                                }
                                            </select>
                                            <input name="Lines[@index].Amount" type="number" min="0" step="100" class="form-control form-control-sm text-end" placeholder="Amount (KES)" value="@(p.Amount?.ToString("0.##"))" />
                                        </div>
                                        <div class="no" style="display:none;">
                                            <select class="form-select form-select-sm mb-1" onchange="presetChanged(this)">
                                                <option value="">Pick a policy reason...</option>
                                                @foreach (var r in reasons)
                                                {
                                                    <option value="@r">@r.Replace(" (sample policy wording).", "")</option>
                                                }
                                            </select>
                                            <input name="Lines[@index].Reason" class="form-control form-control-sm reason" maxlength="500" placeholder="Reason shown to the official (edit or type your own)" value="@p.Reason" />
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </div>
        }

        <div class="mb-3">
            <button type="submit" class="btn btn-outline-primary" asp-page-handler="Preview">Preview</button>
        </div>

        @if (Model.ShowPreview)
        {
            <div class="card border-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Preview</h5>

                    @if (Model.Plans.Count > 0)
                    {
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr><th>Payee</th><th>Budget item</th><th>Description</th><th class="text-end">Amount (KES)</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var plan in Model.Plans)
                                {
                                    <tr>
                                        <td>
                                            @plan.OfficialName
                                            @if (plan.OfficialRole is "Chairman" or "Chapter Secretary")
                                            {
                                                <div><span class="badge bg-warning text-dark">Payee is the @plan.OfficialRole (an approver)</span></div>
                                            }
                                        </td>
                                        <td>@plan.BudgetLabel</td>
                                        <td>
                                            @plan.Description
                                            <div class="text-muted small">
                                                @plan.Description.Length/@ActivityDescription.MaxLength characters@(plan.DescriptionShortened ? " · shortened to fit; the full list of activities stays linked to the voucher" : "")
                                            </div>
                                        </td>
                                        <td class="text-end">@plan.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="3">Total (@Model.Plans.Count voucher@(Model.Plans.Count == 1 ? "" : "s"))</td>
                                    <td class="text-end">@Model.Plans.Sum(v => v.Amount).ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No vouchers, only decisions.</p>
                    }

                    @if (Model.NotPayablePreview.Count > 0)
                    {
                        <div class="alert alert-light border">
                            <strong>@Model.NotPayablePreview.Count line(s) recorded as not payable</strong> (the reason is shown to the official):
                            <ul class="mb-0">
                                @foreach (var (line, d) in Model.NotPayablePreview)
                                {
                                    <li>@line.FullName &ndash; @line.Title: @d.Reason</li>
                                }
                            </ul>
                        </div>
                    }

                    <p class="text-muted small">The vouchers are sent to the Chairman and Chapter Secretary for approval. Where the payee is one of them, the voucher is flagged for the approvers.</p>
                    <button type="submit" class="btn btn-success" asp-page-handler="Create"
                            onclick="return confirm('Create @Model.Plans.Count voucher(s) and record these decisions?');">Create vouchers and record decisions</button>
                </div>
            </div>
        }
    </form>
}

<script>
    function decChanged(sel) {
        var tr = sel.closest('tr');
        var v = sel.value;
        tr.querySelector('.pay').style.display = v === 'Pay' ? 'grid' : 'none';
        tr.querySelector('.no').style.display = v === 'NotPayable' ? 'block' : 'none';
        tr.querySelector('.undecided').style.display = v === '' ? '' : 'none';
    }
    function presetChanged(sel) {
        if (sel.value === '') return;
        sel.closest('tr').querySelector('.reason').value = sel.value;
        sel.selectedIndex = 0;
    }
    function applyBudget(sel) {
        if (!sel.value) return;
        document.querySelectorAll('tr[data-line]').forEach(function (tr) {
            if (tr.querySelector('.decision').value === 'Pay') tr.querySelector('.budget').value = sel.value;
        });
        sel.selectedIndex = 0;
    }
    document.querySelectorAll('.decision').forEach(decChanged);
</script>
