@page
@model UASU_VoucherApprovals.Pages.Payments.RecordModel

<h3 class="mb-3">Record a Payment</h3>
<p class="text-muted">
    Only vouchers approved by both the Chairman and the Chapter Secretary appear below. Tick one or more
    to pay them at once - vouchers for the same payee are combined into one payment; each different payee
    gets a payment of their own. The payment details below apply to all of them.
</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
}

@if (!Model.ApprovedVouchers.Any())
{
    <p class="text-muted">No fully-approved, unpaid vouchers right now.</p>
}
else
{
    @* Grouped by payee - payees with the oldest voucher first, each payee's
       vouchers oldest to newest - since vouchers for the same payee are
       paid together as one payment anyway. *@
    var byPayee = Model.ApprovedVouchers
        .GroupBy(v => v.PayeeDisplay)
        .Select(g => new { Payee = g.Key, Vouchers = g.OrderBy(v => v.VoucherDate).ThenBy(v => v.Voucher_ID).ToList() })
        .OrderBy(g => g.Vouchers[0].VoucherDate).ThenBy(g => g.Payee)
        .ToList();
    var groupNo = 0;

    <form method="post" asp-page="/Payments/Record" id="recordPaymentForm" data-submit-once>
        <table class="table table-bordered align-middle mb-4" style="max-width: 900px;">
            <thead class="table-light">
                <tr>
                    <th style="width:2rem;"><input type="checkbox" class="form-check-input" id="selectAll" title="Select all" /></th>
                    <th>Voucher</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th class="text-end">Amount</th>
                    <th>Description</th>
                </tr>
            </thead>
            @foreach (var g in byPayee)
            {
                groupNo++;
                <tbody class="payee-group" data-group="@groupNo">
                    <tr class="payee-header">
                        <td><input type="checkbox" class="form-check-input group-check" title="Select all for @g.Payee" /></td>
                        <td colspan="3">
                            <span class="fw-semibold">@g.Payee</span>
                            <span class="text-muted small ms-2">@g.Vouchers.Count voucher@(g.Vouchers.Count == 1 ? "" : "s")</span>
                        </td>
                        <td class="text-end fw-semibold">@g.Vouchers.Sum(v => v.Amount).ToString("N2")</td>
                        <td class="text-muted small">
                            @(g.Vouchers[0].VoucherDate == g.Vouchers[^1].VoucherDate ? g.Vouchers[0].VoucherDate.ToString("d MMM yyyy") : $"{g.Vouchers[0].VoucherDate:d MMM} to {g.Vouchers[^1].VoucherDate:d MMM yyyy}")
                        </td>
                    </tr>
                    @foreach (var v in g.Vouchers)
                    {
                        var isChecked = Model.Input.Voucher_IDs.Contains(v.Voucher_ID);
                        <tr class="voucher-row @(isChecked ? "selected" : "")">
                            <td>
                                <input type="checkbox" class="form-check-input voucher-check" name="Input.Voucher_IDs"
                                       value="@v.Voucher_ID" data-amount="@v.Amount" data-payee="@v.PayeeDisplay" checked="@isChecked" />
                            </td>
                            <td class="text-nowrap">@v.Voucher_ID @(v.Is_Legacy ? "(legacy)" : "")</td>
                            <td class="text-nowrap">@v.VoucherDate.ToString("yyyy-MM-dd")</td>
                            <td>@v.Transaction_Type</td>
                            <td class="text-end">@v.Amount.ToString("N2")</td>
                            <td>@v.Description</td>
                        </tr>
                    }
                </tbody>
            }
        </table>

        <div class="card selection-bar border-primary mb-4" style="max-width: 900px;">
            <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div id="selectionSummary"><strong>0 vouchers selected</strong></div>
                <div class="fs-5 fw-bold">Total: Sh. <span id="selectionTotal">0.00</span></div>
            </div>
        </div>

        <div class="card" style="max-width: 640px;">
            <div class="card-header">Payment Details</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Total Paid (Sh.)</label>
                        <input asp-for="Input.Amount_Paid" type="number" step="0.01" class="form-control" readonly />
                        <div class="form-text">Sum of the selected vouchers, each paid in full - one payment per payee.</div>
                        <span asp-validation-for="Input.Amount_Paid" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Payment Mode</label>
                        <select asp-for="Input.Payment_Mode" class="form-select">
                            <option>Bank Transfer</option>
                            <option>M-PESA</option>
                            <option>Cheque</option>
                            <option>Cash</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Reference No.</label>
                        <input asp-for="Input.Reference_No" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Bank Account</label>
                        <input asp-for="Input.Bank_Account" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Funded from Bank Withdrawal (optional)</label>
                        <select asp-for="Input.Withdrawal_Link" class="form-select">
                            <option value="">-- not from a withdrawal --</option>
                            @foreach (var w in Model.AvailableWithdrawals)
                            {
                                <option value="@w.Id">@w.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <span asp-validation-for="Input.Voucher_IDs" class="text-danger d-block mb-2"></span>
                        <button type="submit" class="btn btn-primary" id="submitBtn">Record Payment</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

<style>
    .voucher-row.selected { background: rgba(13,110,253,0.07); }
    .payee-header td { background: var(--bs-tertiary-bg, #f8f9fa); border-top: 2px solid var(--bs-border-color, #dee2e6); }
    .voucher-row td:nth-child(2) { padding-left: 1.25rem; }
</style>

<script>
    function updateSelectionSummary() {
        var checked = Array.from(document.querySelectorAll('.voucher-check:checked'));
        var total = checked.reduce(function (sum, cb) { return sum + parseFloat(cb.getAttribute('data-amount')); }, 0);

        document.getElementById('selectionSummary').innerHTML = checked.length === 0
            ? '<span class="text-muted">No vouchers selected</span>'
            : '<strong>' + checked.length + ' voucher' + (checked.length === 1 ? '' : 's') + ' selected</strong>'
              + ' <span class="text-muted">&mdash; ' + checked.map(function (cb) { return cb.value; }).join(', ') + '</span>';
        document.getElementById('selectionTotal').textContent = total.toFixed(2);
        document.querySelector('[name="Input.Amount_Paid"]').value = total.toFixed(2);

        document.querySelectorAll('.voucher-row').forEach(function (row) {
            var cb = row.querySelector('.voucher-check');
            row.classList.toggle('selected', cb.checked);
        });

        // Each payee's tick box shows ticked / unticked / partly ticked.
        document.querySelectorAll('.payee-group').forEach(function (group) {
            var boxes = Array.from(group.querySelectorAll('.voucher-check'));
            var n = boxes.filter(function (b) { return b.checked; }).length;
            var gc = group.querySelector('.group-check');
            gc.checked = n === boxes.length;
            gc.indeterminate = n > 0 && n < boxes.length;
        });

        var submitBtn = document.getElementById('submitBtn');
        var payeeCount = new Set(checked.map(function (cb) { return cb.getAttribute('data-payee'); })).size;
        submitBtn.textContent = payeeCount <= 1 ? 'Record Payment' : 'Record ' + payeeCount + ' Payments (one per payee)';
    }

    document.querySelectorAll('.voucher-check').forEach(function (cb) {
        cb.addEventListener('change', updateSelectionSummary);
    });

    document.querySelectorAll('.group-check').forEach(function (gc) {
        gc.addEventListener('change', function () {
            gc.closest('.payee-group').querySelectorAll('.voucher-check').forEach(function (cb) { cb.checked = gc.checked; });
            updateSelectionSummary();
        });
    });

    var selectAll = document.getElementById('selectAll');
    if (selectAll) {
        selectAll.addEventListener('change', function () {
            document.querySelectorAll('.voucher-check').forEach(function (cb) { cb.checked = selectAll.checked; });
            updateSelectionSummary();
        });
    }

    updateSelectionSummary();
</script>
