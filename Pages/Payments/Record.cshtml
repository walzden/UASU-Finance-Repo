@page
@model UASU_VoucherApprovals.Pages.Payments.RecordModel

<h3 class="mb-3">Record a Payment</h3>
<p class="text-muted">
    Only vouchers approved by both the Chairman and the Chapter Secretary appear below. Tick one or more
    to settle together with a single payment - useful when several allowances for the same event are
    disbursed as one transaction.
</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
}

@if (!Model.ApprovedVouchers.Any())
{
    <p class="text-muted">No fully-approved, unpaid vouchers right now.</p>
}
else
{
    <form method="post" asp-page="/Payments/Record" id="recordPaymentForm">
        <table class="table table-bordered table-hover align-middle mb-4" style="max-width: 900px;">
            <thead class="table-light">
                <tr>
                    <th style="width:2rem;"><input type="checkbox" class="form-check-input" id="selectAll" title="Select all" /></th>
                    <th>Voucher</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Payee</th>
                    <th class="text-end">Amount</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.ApprovedVouchers)
                {
                    var isChecked = Model.Input.Voucher_IDs.Contains(v.Voucher_ID);
                    <tr class="voucher-row @(isChecked ? "selected" : "")">
                        <td>
                            <input type="checkbox" class="form-check-input voucher-check" name="Input.Voucher_IDs"
                                   value="@v.Voucher_ID" data-amount="@v.Amount" checked="@isChecked" />
                        </td>
                        <td>@v.Voucher_ID @(v.Is_Legacy ? "(legacy)" : "")</td>
                        <td>@v.VoucherDate.ToString("yyyy-MM-dd")</td>
                        <td>@v.Transaction_Type</td>
                        <td>@v.PayeeDisplay</td>
                        <td class="text-end">@v.Amount.ToString("N2")</td>
                        <td>@v.Description</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="card selection-bar border-primary mb-4" style="max-width: 900px;">
            <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div id="selectionSummary"><strong>0 vouchers selected</strong></div>
                <div class="fs-5 fw-bold">Total: Sh. <span id="selectionTotal">0.00</span></div>
            </div>
        </div>

        <div class="card" style="max-width: 640px;">
            <div class="card-header">Payment Details</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Amount Paid (Sh.)</label>
                        <input asp-for="Input.Amount_Paid" type="number" step="0.01" class="form-control" readonly />
                        <div class="form-text">Sum of the selected vouchers - settling them in full.</div>
                        <span asp-validation-for="Input.Amount_Paid" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Payment Mode</label>
                        <select asp-for="Input.Payment_Mode" class="form-select">
                            <option>Bank Transfer</option>
                            <option>M-PESA</option>
                            <option>Cheque</option>
                            <option>Cash</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Reference No.</label>
                        <input asp-for="Input.Reference_No" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Bank Account</label>
                        <input asp-for="Input.Bank_Account" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Funded from Bank Withdrawal (optional)</label>
                        <select asp-for="Input.Withdrawal_Link" class="form-select">
                            <option value="">-- not from a withdrawal --</option>
                            @foreach (var w in Model.AvailableWithdrawals)
                            {
                                <option value="@w.Id">@w.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <span asp-validation-for="Input.Voucher_IDs" class="text-danger d-block mb-2"></span>
                        <button type="submit" class="btn btn-primary" id="submitBtn">Record Payment</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

<style>
    .voucher-row.selected { background: rgba(13,110,253,0.07); }
</style>

<script>
    function updateSelectionSummary() {
        var checked = Array.from(document.querySelectorAll('.voucher-check:checked'));
        var total = checked.reduce(function (sum, cb) { return sum + parseFloat(cb.getAttribute('data-amount')); }, 0);

        document.getElementById('selectionSummary').innerHTML = checked.length === 0
            ? '<span class="text-muted">No vouchers selected</span>'
            : '<strong>' + checked.length + ' voucher' + (checked.length === 1 ? '' : 's') + ' selected</strong>'
              + ' <span class="text-muted">&mdash; ' + checked.map(function (cb) { return cb.value; }).join(', ') + '</span>';
        document.getElementById('selectionTotal').textContent = total.toFixed(2);
        document.querySelector('[name="Input.Amount_Paid"]').value = total.toFixed(2);

        document.querySelectorAll('.voucher-row').forEach(function (row) {
            var cb = row.querySelector('.voucher-check');
            row.classList.toggle('selected', cb.checked);
        });

        var submitBtn = document.getElementById('submitBtn');
        submitBtn.textContent = checked.length <= 1 ? 'Record Payment' : 'Record Payment for ' + checked.length + ' Vouchers';
    }

    document.querySelectorAll('.voucher-check').forEach(function (cb) {
        cb.addEventListener('change', updateSelectionSummary);
    });

    var selectAll = document.getElementById('selectAll');
    if (selectAll) {
        selectAll.addEventListener('change', function () {
            document.querySelectorAll('.voucher-check').forEach(function (cb) { cb.checked = selectAll.checked; });
            updateSelectionSummary();
        });
    }

    updateSelectionSummary();
</script>
