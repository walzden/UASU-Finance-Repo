@page
@model UASU_VoucherApprovals.Pages.Budgets.IndexModel

<h3 class="mb-3">Proposed Budgets</h3>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label mb-0">Fiscal Year</label>
        <select name="year" class="form-select" onchange="this.form.submit()">
            @foreach (var y in Model.AvailableYears)
            {
                <option value="@y" selected="@(Model.FiscalYear == y)">@y</option>
            }
            @if (!Model.AvailableYears.Contains(Model.FiscalYear))
            {
                <option value="@Model.FiscalYear" selected>@Model.FiscalYear</option>
            }
        </select>
    </div>
</form>

@if (!Model.ProposedBudgets.Any())
{
    <p class="text-muted">No proposed budgets for @Model.FiscalYear yet.</p>
}
else
{
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Budget Code</th>
                <th>Type</th>
                <th class="text-end">Proposed Amount (Sh.)</th>
                <th>Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.ProposedBudgets)
            {
                <tr>
                    <td>@p.Category_Name</td>
                    <td>@p.Category_Type</td>
                    <td class="text-end">@p.Proposed_Amount.ToString("N2")</td>
                    <td>@p.Notes</td>
                    <td><a asp-page="/Budgets/Edit" asp-route-proposalId="@p.Proposal_ID">Edit</a></td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light fw-bold">
            <tr>
                <td colspan="2">Total</td>
                <td class="text-end">@Model.ProposedBudgets.Sum(p => p.Proposed_Amount).ToString("N2")</td>
                <td colspan="2"></td>
            </tr>
        </tfoot>
    </table>
}

<h4 class="mt-4">Add Proposed Budget</h4>
<form method="post" asp-page="/Budgets/Index" class="row g-3" style="max-width: 640px;">
    <div class="col-12">
        <label class="form-label">Budget Code</label>
        <select asp-for="Input.Budget_Link" class="form-select">
            @foreach (var b in Model.BudgetCodes)
            {
                <option value="@b.Id">@b.Label</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Fiscal Year</label>
        <input asp-for="Input.Fiscal_Year" class="form-control" />
        <span asp-validation-for="Input.Fiscal_Year" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Proposed Amount</label>
        <input asp-for="Input.Proposed_Amount" class="form-control" />
        <span asp-validation-for="Input.Proposed_Amount" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label class="form-label">Notes</label>
        <input asp-for="Input.Notes" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Add Proposed Budget</button>
    </div>
</form>
