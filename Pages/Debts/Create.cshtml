@page
@model UASU_VoucherApprovals.Pages.Debts.CreateModel

<h3 class="mb-3">Record a New Debt</h3>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
}

<form method="post" asp-page="/Debts/Create" class="row g-3" style="max-width: 640px;">
    <div class="col-md-6">
        <label class="form-label">Creditor Type</label>
        <select asp-for="Input.Creditor_Type" class="form-select" onchange="toggleCreditorFields(this.value)">
            <option value="Supplier">Supplier</option>
            <option value="Official">Official</option>
        </select>
    </div>

    <div class="col-md-6">
        <label class="form-label">Amount Owed (Sh.)</label>
        <input asp-for="Input.Total_Owed" type="number" step="0.01" class="form-control" />
    </div>

    <div class="col-md-6" id="officialField">
        <label class="form-label">Official (if Creditor = Official)</label>
        <select asp-for="Input.Official_link" class="form-select">
            <option value="">-- none --</option>
            @foreach (var o in Model.Officials)
            {
                <option value="@o.Id">@o.Label</option>
            }
        </select>
    </div>

    <div class="col-md-6" id="supplierField">
        <label class="form-label">Supplier (if Creditor = Supplier)</label>
        <select asp-for="Input.Supplier_link" class="form-select">
            <option value="">-- none --</option>
            @foreach (var s in Model.Suppliers)
            {
                <option value="@s.Id">@s.Label</option>
            }
        </select>
    </div>

    <div class="col-md-6">
        <label class="form-label">Date Incurred</label>
        <input asp-for="Input.Date_Incurred" type="date" class="form-control" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Invoice No.</label>
        <input asp-for="Input.Invoice_No" class="form-control" />
    </div>

    <div class="col-12">
        <label class="form-label">Description</label>
        <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Record Debt</button>
    </div>
</form>

<script>
    function toggleCreditorFields(type) {
        document.getElementById('officialField').style.display = type === 'Official' ? '' : 'none';
        document.getElementById('supplierField').style.display = type === 'Supplier' ? '' : 'none';
    }
    toggleCreditorFields(document.querySelector('[name="Input.Creditor_Type"]').value);
</script>
