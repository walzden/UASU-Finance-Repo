@page
@using System.Globalization
@model UASU_VoucherApprovals.Pages.Debts.CreateModel
@{
    var isSupplier = Model.Input.Creditor_Type == "Supplier";
    var posted = Model.Input.Officials.Where(l => !string.IsNullOrEmpty(l.OfficialID))
                     .GroupBy(l => l.OfficialID).ToDictionary(g => g.Key, g => g.First());
}

<div style="max-width: 860px;">

<h3 class="mb-1">Record a New Debt</h3>
<p class="text-muted">Money the union owes. Tick one official for a personal debt, or several for a common debt &mdash; each official gets their own debt for their share, all with the same description and dates.</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")">@Model.StatusMessage</div>
}

<form method="post" data-submit-once asp-page="/Debts/Create" id="debtForm">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div class="fw-semibold mb-1">Not saved &mdash; fix the fields marked in red:</div>
            <div asp-validation-summary="All" class="mb-0"></div>
        </div>
    }

    @* ---------------------------------------------------------- 1. Who *@
    <div class="card mb-3">
        <div class="card-header fw-semibold">1. Who is owed</div>
        <div class="card-body">
            <div class="btn-group mb-3" role="group" aria-label="Creditor type">
                <input type="radio" class="btn-check" name="Input.Creditor_Type" id="typeOfficial" value="Official" checked="@(!isSupplier)" />
                <label class="btn btn-outline-primary" for="typeOfficial">Official(s)</label>
                <input type="radio" class="btn-check" name="Input.Creditor_Type" id="typeSupplier" value="Supplier" checked="@isSupplier" />
                <label class="btn btn-outline-primary" for="typeSupplier">Supplier</label>
            </div>

            <div id="officialPart">
                <div class="row g-2 align-items-end mb-2">
                    <div class="col-sm-5 col-md-4">
                        <label for="defaultAmount" class="form-label small mb-1">Amount per official (Sh.)</label>
                        <input type="number" step="0.01" min="0.01" id="defaultAmount" class="form-control text-end" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-outline-secondary" id="applyAmount">Apply to ticked</button>
                    </div>
                    <div class="col text-sm-end small">
                        <button type="button" class="btn btn-sm btn-link px-1" id="tickAll">Tick all current</button> |
                        <button type="button" class="btn btn-sm btn-link px-1" id="tickNone">Untick all</button>
                    </div>
                </div>

                <div class="official-list border rounded">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr><th style="width:2rem;"></th><th>Official</th><th class="text-end" style="width:11rem;">Amount (Sh.)</th></tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Officials.Count; i++)
                            {
                                var o = Model.Officials[i];
                                posted.TryGetValue(o.Id, out var line);
                                var former = o.Label.Contains("- former");
                                <tr class="off-row @(former ? "former" : "")">
                                    <td>
                                        <input type="hidden" name="Input.Officials[@i].OfficialID" value="@o.Id" />
                                        <input type="checkbox" class="form-check-input pick" name="Input.Officials[@i].Selected" value="true"
                                               id="off-@i" checked="@(line?.Selected ?? false)" />
                                    </td>
                                    <td><label for="off-@i" class="mb-0 @(former ? "text-muted" : "")">@o.Label</label></td>
                                    <td>
                                        <input type="number" step="0.01" min="0.01" class="form-control form-control-sm text-end amount"
                                               name="Input.Officials[@i].Amount" value="@(line?.Amount?.ToString("0.00", CultureInfo.InvariantCulture))" />
                                        <span asp-validation-for="Input.Officials[i].Amount"></span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <span asp-validation-for="Input.Officials"></span>
                <div class="form-text">Former officials are listed last &mdash; arrears owed after leaving office are still debts.</div>
            </div>

            <div id="supplierPart" class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Input.Supplier_link" class="form-label">Supplier</label>
                    <select asp-for="Input.Supplier_link" class="form-select">
                        <option value="">-- select --</option>
                        @foreach (var s in Model.Suppliers)
                        {
                            <option value="@s.Id">@s.Label</option>
                        }
                    </select>
                    <span asp-validation-for="Input.Supplier_link"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Supplier_Amount" class="form-label">Amount owed (Sh.)</label>
                    <input asp-for="Input.Supplier_Amount" type="number" step="0.01" min="0.01" class="form-control text-end" />
                    <span asp-validation-for="Input.Supplier_Amount"></span>
                </div>
            </div>
        </div>
    </div>

    @* ------------------------------------------------------- 2. What for *@
    <div class="card mb-3">
        <div class="card-header fw-semibold">2. What it's for</div>
        <div class="card-body row g-3">
            <div class="col-md-8">
                <label asp-for="Input.Description" class="form-label">Description</label>
                <input asp-for="Input.Description" class="form-control" maxlength="255"
                       placeholder="e.g. NEC meeting allowance, Nairobi" />
                <span asp-validation-for="Input.Description"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Invoice_No" class="form-label">Invoice / reference <span class="text-muted small">(optional)</span></label>
                <input asp-for="Input.Invoice_No" class="form-control" maxlength="50" />
                <span asp-validation-for="Input.Invoice_No"></span>
            </div>
        </div>
    </div>

    @* ----------------------------------------------------------- 3. When *@
    <div class="card mb-3">
        <div class="card-header fw-semibold">3. When</div>
        <div class="card-body row g-3 align-items-end">
            <div class="col-12">
                <div class="btn-group" role="group" aria-label="Single day or several days">
                    <input type="radio" class="btn-check" name="Input.Spans_Days" id="oneDay" value="false" checked="@(!Model.Input.Spans_Days)" />
                    <label class="btn btn-outline-secondary btn-sm" for="oneDay">Single day</label>
                    <input type="radio" class="btn-check" name="Input.Spans_Days" id="severalDays" value="true" checked="@Model.Input.Spans_Days" />
                    <label class="btn btn-outline-secondary btn-sm" for="severalDays">Several days</label>
                </div>
            </div>
            <div class="col-sm-6 col-md-4">
                <label asp-for="Input.Date_Incurred" class="form-label" id="fromLabel">Date incurred</label>
                <input asp-for="Input.Date_Incurred" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Input.Date_Incurred"></span>
            </div>
            <div class="col-sm-6 col-md-4" id="toPart">
                <label asp-for="Input.Date_Incurred_To" class="form-label">Last day</label>
                <input asp-for="Input.Date_Incurred_To" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Input.Date_Incurred_To"></span>
            </div>
        </div>
    </div>

    <div class="card border-primary mb-5">
        <div class="card-body d-flex align-items-center flex-wrap gap-3">
            <div id="summary" class="fw-semibold"></div>
            <button type="submit" class="btn btn-primary ms-auto" id="saveBtn">Record debt</button>
        </div>
    </div>
</form>

</div>

<style>
    .official-list { max-height: 24rem; overflow-y: auto; }
    .official-list thead th { position: sticky; top: 0; z-index: 1; }
    .off-row.picked { background: rgba(13,110,253,0.06); }
</style>

<script>
    (function () {
        var form = document.getElementById('debtForm');
        var rows = Array.prototype.slice.call(form.querySelectorAll('.off-row'));
        var fmt = function (n) { return n.toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
        var isSupplier = function () { return document.getElementById('typeSupplier').checked; };
        var spans = function () { return document.getElementById('severalDays').checked; };

        function update() {
            var sup = isSupplier();
            document.getElementById('officialPart').style.display = sup ? 'none' : '';
            document.getElementById('supplierPart').style.display = sup ? '' : 'none';
            document.getElementById('toPart').style.display = spans() ? '' : 'none';
            document.getElementById('fromLabel').textContent = spans() ? 'First day' : 'Date incurred';

            var text, n = 0, total = 0;
            if (sup) {
                total = parseFloat(document.querySelector('[name="Input.Supplier_Amount"]').value) || 0;
                n = 1;
                text = 'Supplier debt · Sh. ' + fmt(total);
            } else {
                rows.forEach(function (r) {
                    var on = r.querySelector('.pick').checked;
                    r.classList.toggle('picked', on);
                    r.querySelector('.amount').required = on;
                    if (on) { n++; total += parseFloat(r.querySelector('.amount').value) || 0; }
                });
                text = n === 0 ? 'No official ticked'
                     : (n === 1 ? 'Personal debt' : 'Common debt for ' + n + ' officials') + ' · Sh. ' + fmt(total);
            }
            document.getElementById('summary').textContent = text;
            var btn = document.getElementById('saveBtn');
            btn.textContent = sup || n <= 1 ? 'Record debt' : 'Record ' + n + ' debts';
            btn.disabled = !sup && n === 0;
        }

        form.addEventListener('change', update);
        form.addEventListener('input', update);
        // Typing an amount ticks that official.
        rows.forEach(function (r) {
            r.querySelector('.amount').addEventListener('input', function () { r.querySelector('.pick').checked = true; update(); });
        });
        document.getElementById('applyAmount').addEventListener('click', function () {
            var v = document.getElementById('defaultAmount').value;
            if (!v) { document.getElementById('defaultAmount').focus(); return; }
            rows.forEach(function (r) { if (r.querySelector('.pick').checked) r.querySelector('.amount').value = v; });
            update();
        });
        document.getElementById('tickAll').addEventListener('click', function () {
            rows.forEach(function (r) { if (!r.classList.contains('former')) r.querySelector('.pick').checked = true; });
            update();
        });
        document.getElementById('tickNone').addEventListener('click', function () {
            rows.forEach(function (r) { r.querySelector('.pick').checked = false; });
            update();
        });
        form.addEventListener('submit', function (e) {
            var n = isSupplier() ? 1 : rows.filter(function (r) { return r.querySelector('.pick').checked; }).length;
            if (n > 1 && !confirm('Record a common debt for ' + n + ' officials (one debt each)?')) e.preventDefault();
        });
        update();
    })();
</script>
