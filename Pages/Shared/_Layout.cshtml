<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UASU Finance</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/uasu-theme.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-uasu mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">UASU Finance</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                bool isTreasuryAdmin = User.IsInRole("Treasurer") || User.IsInRole("Deputy Treasurer");
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto">
                        @* Its own top-level item so every signed-in official sees it straight away. *@
                        <li class="nav-item"><a class="nav-link" href="/Activities/Log">Log Activity</a></li>
                        @if (User.IsInRole("Chairman") || User.IsInRole("Chapter Secretary"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/Approvals">Pending Approvals</a></li>
                        }
                        @if (isTreasuryAdmin)
                        {
                            <li class="nav-item"><a class="nav-link" href="/Activities/Decide">Activity Decisions</a></li>
                        }
                        @if (isTreasuryAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Manage</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Vouchers/Create">New Voucher</a></li>
                                    <li><a class="dropdown-item" href="/Vouchers/Pending">Pending Vouchers</a></li>
                                    <li><a class="dropdown-item" href="/Honoraria/Generate">Generate Monthly Honoraria</a></li>
                                    <li><a class="dropdown-item" href="/Honoraria/Rates">Honoraria Rates</a></li>
                                    <li><a class="dropdown-item" href="/Debts/Create">New Debt</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/Payments/Record">Record Payment</a></li>
                                    <li><a class="dropdown-item" href="/Payments/AddAllocation">Add Voucher to Payment</a></li>
                                    <li><a class="dropdown-item" href="/Payments/Acknowledge">Acknowledge Receipt</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/Banking/Withdrawals">Bank Withdrawals</a></li>
                                    <li><a class="dropdown-item" href="/Payments/Charges">Log a Payment Charge</a></li>
                                    <li><a class="dropdown-item" href="/Banking/AccountCharges">Account Charges</a></li>
                                    <li><a class="dropdown-item" href="/Certification/Index">Monthly Certification</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/Officials/Index">Officials</a></li>
                                    <li><a class="dropdown-item" href="/Suppliers/Index">Suppliers</a></li>
                                    <li><a class="dropdown-item" href="/BudgetCodes/Index">Budget Codes</a></li>
                                    <li><a class="dropdown-item" href="/Budgets/Index">Proposed Budgets</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/MemberRegister/Index">Union Contributors</a></li>
                                    <li><a class="dropdown-item" href="/MemberRegister/RecordContributions">Record Contributions</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/Account/SeedDefaultLogins">Add Logins</a></li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Reports</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/Reports">Income &amp; Expense</a></li>
                                <li><a class="dropdown-item" href="/Reports/CashBook">Cash Book (Form V)</a></li>
                                <li><a class="dropdown-item" href="/Reports/BudgetPerformance">Budget Performance</a></li>
                                <li><a class="dropdown-item" href="/Reports/Debts">Debt Status</a></li>
                                <li><a class="dropdown-item" href="/Reports/WithdrawalBreakdown">Withdrawal Breakdown</a></li>
                                <li><a class="dropdown-item" href="/Reports/FormR">Payment Voucher (Form R)</a></li>
                                <li><a class="dropdown-item" href="/Reports/FormQ">Treasurer's Receipt (Form Q)</a></li>
                                <li><a class="dropdown-item" href="/Reports/MemberRegister">Union Member Register</a></li>
                                <li><a class="dropdown-item" href="/Reports/BalanceSheet">Balance Sheet</a></li>
                                <li><a class="dropdown-item" href="/Reports/OfficialTotals">Official Totals</a></li>
                                <li><a class="dropdown-item" href="/Reports/ApprovedVouchers">Approved Vouchers</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                @User.Identity!.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Account/ChangePassword">Change Password</a></li>
                            </ul>
                        </li>
                        <li class="nav-item mt-2 mt-lg-0">
                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                            </form>
                        </li>
                    </ul>
                </div>

                <div class="modal fade" id="idleTimeoutModal" tabindex="-1" aria-labelledby="idleTimeoutModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="idleTimeoutModalLabel">Still there?</h5>
                            </div>
                            <div class="modal-body">
                                <p class="mb-0">You've been idle for a while. For security, you'll be logged out in <strong id="idleTimeoutCountdown">60</strong> seconds.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" id="idleTimeoutLogoutBtn">Log out now</button>
                                <button type="button" class="btn btn-primary" id="idleTimeoutStayBtn">Stay signed in</button>
                            </div>
                        </div>
                    </div>
                </div>
                <form id="idle-logout-form" method="post" asp-page="/Account/Logout" class="d-none"></form>
                <script src="~/js/idle-timeout.js" defer></script>
            }
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>
</body>
</html>
