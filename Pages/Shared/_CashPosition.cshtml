@model UASU_VoucherApprovals.Models.CashPosition
@{
    var canOpenFloats = User.IsInRole("Treasurer") || User.IsInRole("Deputy Treasurer");
}

@* Live cash position: the book Cash balance and where it physically is.
   Shared by the home page and Cash Floats; same figures as Monthly
   Certification uses for a month-end. *@
<div class="card mb-4" style="max-width: 640px;">
    <div class="card-header d-flex justify-content-between align-items-baseline">
        <span class="fw-semibold">Cash on Hand &mdash; as at @Model.AsOf.ToString("d MMM yyyy")</span>
        @if (canOpenFloats)
        {
            <a href="/Floats" class="small">Cash floats &rarr;</a>
        }
    </div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <tbody>
                <tr class="fw-bold">
                    <td class="ps-3">Cash in hand (book)</td>
                    <td class="text-end pe-3">Sh. @Model.BookCash.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="ps-4">With the treasury</td>
                    <td class="text-end pe-3">@Model.CashWithTreasury.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="ps-4">
                        Out in cash floats
                        <span class="text-muted small">(@Model.OpenFloats open)</span>
                    </td>
                    <td class="text-end pe-3">@Model.InFloats.ToString("N2")</td>
                </tr>
                @if (Model.InFloats != 0)
                {
                    <tr class="text-muted small">
                        <td class="ps-5">cash still with float holders</td>
                        <td class="text-end pe-3">@Model.FloatCashWithCustodians.ToString("N2")</td>
                    </tr>
                    <tr class="text-muted small">
                        <td class="ps-5">spent, receipts awaiting approval/settlement</td>
                        <td class="text-end pe-3">@Model.FloatReceiptsNotSettled.ToString("N2")</td>
                    </tr>
                }
                <tr class="border-top">
                    <td class="ps-3">Expected physical count (treasury + float holders)</td>
                    <td class="text-end pe-3 fw-semibold">Sh. @Model.ExpectedPhysicalCash.ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
