@page "{officialId}"
@model UASU_VoucherApprovals.Pages.Officials.EditModel

<h3 class="mb-3">Edit Official - @Model.OfficialId</h3>

<form method="post" asp-page="/Officials/Edit" class="row g-3" style="max-width: 640px;">
    <div class="col-12">
        <label class="form-label">Full Name</label>
        <input asp-for="Input.FullName" class="form-control" />
        <span asp-validation-for="Input.FullName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Role</label>
        <input asp-for="Input.Role" class="form-control" list="roleOptions" />
        <datalist id="roleOptions">
            <option value="Chairman"></option>
            <option value="Chapter Secretary"></option>
            <option value="Treasurer"></option>
            <option value="Deputy Treasurer"></option>
        </datalist>
        <div class="form-text">Must exactly match Chairman / Chapter Secretary / Treasurer / Deputy Treasurer to be offered a login on Add Logins.</div>
    </div>
    <div class="col-md-6 form-check mt-4">
        <input asp-for="Input.IsCurrent" type="checkbox" class="form-check-input" />
        <label asp-for="Input.IsCurrent" class="form-check-label">Currently serving</label>
        <div class="form-text">Unchecking this blocks login immediately (existing accounts stay on file, just can't sign in) and hides them from new voucher payee dropdowns.</div>
    </div>
    <div class="col-md-6">
        <label class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Phone</label>
        <input asp-for="Input.Phone_No" class="form-control" />
    </div>
    <div class="col-12">
        <label class="form-label">Address</label>
        <input asp-for="Input.Address" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-page="/Officials/Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
