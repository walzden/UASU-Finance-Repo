<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7671f71a-d555-4435-854c-0d5a9544ccf0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <!-- Tools/HashPasswordCli is its own separate console project (own
       .csproj, own Program.cs with top-level statements). Without this
       exclusion, this web app's default file globbing would try to
       compile that Program.cs too, and the build would fail with two
       conflicting entry points. -->
  <ItemGroup>
    <Compile Remove="Tools/**/*.cs" />
  </ItemGroup>

</Project>
